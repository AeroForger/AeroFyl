use lexer;
use std.io;

public void main() {
    list Token tokens = lex("lexer_fixture.fyl");
    list Token malformed = lex("lexer_malformed_fixture.fyl");

/*
    int i = 0;
    while (i < tokens.length) {
        print(tokens[i].span.start);
        print(",");
        println(tokens[i].span.end);

        i += 1;
    }
*/
    if (tokens.length != 49) {
        exit(70);
    }
    if (malformed.length != 1 || !malformed[0].kind.is(TokenKind.Eof)) {
        exit(70);
    }

    Keyword first = tokens[0].kind.payload(TokenKind.Keyword);
    string decimal = tokens[13].kind.payload(TokenKind.Float);
    string text = tokens[18].kind.payload(TokenKind.String);
    char newline = tokens[23].kind.payload(TokenKind.Char);
    if (first != Keyword.Public
        || decimal != "3.5"
        || text != "a\n\"b"
        || newline != '\n'
        || !tokens[26].kind.is(TokenKind.PlusEqual)
        || !tokens[48].kind.is(TokenKind.Eof)) {
        exit(70);
    }
}
