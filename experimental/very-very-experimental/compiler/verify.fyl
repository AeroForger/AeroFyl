// The empty entry loop avoids the unchanged bootstrap verifier fixed-point bug.
//i donnot care about factual comments
use model;
use types;

public bool valid_slot(CompiledFunction function,int slot) { while (false) {} return slot>=0 && slot<function.frameSlots && slot<function.valueTypes.length; }
public int slot_type(CompiledFunction function,int slot) { while (false) {}
    if (!valid_slot(function,slot)) { return -1; }
    return function.valueTypes[slot];
}
public bool label_exists(CompiledFunction function,int label) { while (false) {}
    for (int i=0;i<function.instructions.length;i+=1) {
        Instruction value=function.instructions[i]; if (value.op==Op.label && value.value==label) { return true; }
    }
    return false;
}
public string verify_group_0(CompileProgram program,CompiledFunction function,Instruction value) { while (false) {}
    if (value.op==Op.arrayValue || value.op==Op.listValue || value.op==Op.structValue) {
        TypeDef definition=program.types[value.ty];
        if (value.op==Op.arrayValue && definition.kind!=TypeTag.array) { return "array construction has invalid type"; }
        if (value.op==Op.listValue && definition.kind!=TypeTag.sequence) { return "list construction has invalid type"; }
        if (value.op==Op.structValue && definition.kind!=TypeTag.record) { return "struct construction has invalid type"; }
        if (value.op==Op.arrayValue && value.args.length!=definition.length) { return "array construction length mismatch"; }
        if (value.op==Op.structValue && value.args.length!=definition.members.length) { return "struct construction field count mismatch"; }
        for (int i=0;i<value.args.length;i+=1) {
            int required=definition.inner; if (value.op==Op.structValue) { required=definition.members[i]; }
            if (slot_type(function,value.args[i])!=required) { return "aggregate constructor operand type mismatch"; }
        }
        return "";
    }
    if (value.op==Op.inputValue || value.op==Op.optionalNone) { return ""; }
    if (value.op==Op.enumValue) {
        TypeDef definition=program.types[value.ty];
        if (definition.kind!=TypeTag.enumeration || value.value<0 || value.value>=definition.members.length) { return "invalid enum constructor metadata"; }
        int payload=definition.members[value.value];
        if (payload>=0 && slot_type(function,value.a)!=payload) { return "enum payload has wrong type"; }
        if (payload<0 && value.a!=-1) { return "payload-free enum constructor has an operand"; }
        return "";
    }
    return "unrecognized instruction";
}
public string verify_group_1(CompileProgram program,CompiledFunction function,Instruction value) { while (false) {}
    int aType=slot_type(function,value.a);
    if (aType<0) { return "instruction reads an invalid slot"; }
    if (value.op==Op.copy || value.op==Op.loadLocal || value.op==Op.storeLocal || value.op==Op.structCopy) {
        if (aType!=value.ty) { return "copy operand type mismatch"; }
        if (value.op==Op.structCopy && program.types[value.ty].kind!=TypeTag.record) { return "record copy requires a record"; }
        return "";
    }
    if (value.op==Op.neg || value.op==Op.notValue) {
        int required=1; if (value.op==Op.notValue) { required=2; }
        if (aType!=required || value.ty!=required) { return "unary operation type mismatch"; }
        return "";
    }
    if (value.op==Op.exitValue) { if (aType!=1) { return "exit requires int"; } return ""; }
    if (value.op==Op.output) { if (aType!=value.ty || value.ty==0 || value.value<0 || value.value>3) { return "invalid output metadata"; } return ""; }
    if (value.op==Op.convert) {
        if (aType!=value.c || value.c<0 || value.c>=program.types.length) { return "invalid conversion source metadata"; }
        return "";
    }
    if (value.op==Op.fieldLoad || value.op==Op.fieldStore) {
        TypeDef definition=program.types[aType];
        if (definition.kind!=TypeTag.record || value.value<0 || value.value>=definition.members.length) { return "invalid record field metadata"; }
        if (value.ty!=definition.members[value.value]) { return "field result type mismatch"; }
        if (value.op==Op.fieldStore && slot_type(function,value.b)!=value.ty) { return "field store operand type mismatch"; }
        return "";
    }
    if (value.op==Op.enumIs || value.op==Op.enumPayload) {
        TypeDef definition=program.types[aType];
        if (definition.kind!=TypeTag.enumeration || value.value<0 || value.value>=definition.members.length) { return "invalid enum inspection metadata"; }
        if (value.op==Op.enumIs && value.ty!=2) { return "enum test must produce bool"; }
        if (value.op==Op.enumPayload && value.ty!=definition.members[value.value]) { return "enum payload result type mismatch"; }
        return "";
    }
    return "unrecognized instruction";
}
public string verify_group_2(CompileProgram program,CompiledFunction function,Instruction value) { while (false) {}
    int aType=slot_type(function,value.a);
    if (value.op==Op.optionalSome || value.op==Op.referenceValue) {
        TypeDef definition=program.types[value.ty];
        TypeTag required=TypeTag.maybe; if (value.op==Op.referenceValue) { required=TypeTag.referenceType; }
        if (definition.kind!=required || definition.inner!=aType) { return "invalid optional/reference construction"; }
        return "";
    }
    if (value.op==Op.optionalHas || value.op==Op.optionalValue || value.op==Op.referenceLoad || value.op==Op.referenceStore) {
        TypeDef definition=program.types[aType]; TypeTag required=TypeTag.maybe;
        if (value.op==Op.referenceLoad || value.op==Op.referenceStore) { required=TypeTag.referenceType; }
        if (definition.kind!=required) { return "invalid optional/reference access"; }
        if (value.op==Op.optionalHas) { if (value.ty!=2) { return "optional test must produce bool"; } }
        else if (definition.inner!=value.ty) { return "optional/reference result mismatch"; }
        if (value.op==Op.referenceStore && slot_type(function,value.b)!=value.ty) { return "reference store type mismatch"; }
        return "";
    }
    if (value.op==Op.length) {
        TypeDef definition=program.types[aType];
        if (value.ty!=1 || (aType!=4 && definition.kind!=TypeTag.array && definition.kind!=TypeTag.sequence && definition.kind!=TypeTag.arguments)) { return "invalid length operation"; }
        return "";
    }
    if (value.op==Op.indexLoad || value.op==Op.indexStore || value.op==Op.listPush || value.op==Op.listPop) {
        TypeDef definition=program.types[aType]; int element=definition.inner;
        if (definition.kind==TypeTag.arguments) { element=4; }
        if (definition.kind!=TypeTag.array && definition.kind!=TypeTag.sequence && definition.kind!=TypeTag.arguments) { return "indexed operation requires a collection"; }
        if ((value.op==Op.listPush || value.op==Op.listPop) && definition.kind!=TypeTag.sequence) { return "list operation requires list"; }
        if (value.ty!=element) { return "collection element type mismatch"; }
        if ((value.op==Op.indexLoad || value.op==Op.indexStore) && slot_type(function,value.b)!=1) { return "collection index must be int"; }
        if (value.op==Op.indexStore && slot_type(function,value.value)!=element) { return "indexed store value has wrong type"; }
        if (value.op==Op.listPush && slot_type(function,value.b)!=element) { return "list push operand mismatch"; }
        return "";
    }
    return "unrecognized instruction";
}
public string verify_group_3(CompileProgram program,CompiledFunction function,Instruction value) { while (false) {}
    int aType=slot_type(function,value.a);
    if (value.op==Op.readFileValue || value.op==Op.readBytesValue || value.op==Op.existsValue || value.op==Op.writeFileValue || value.op==Op.writeBytesValue) {
        if (aType!=4) { return "filesystem path must be string"; }
        if (value.op==Op.writeFileValue && slot_type(function,value.b)!=4) { return "writeFile data must be string"; }
        if (value.op==Op.writeBytesValue) { int dataType=slot_type(function,value.b); if (dataType<0 || program.types[dataType].kind!=TypeTag.sequence || program.types[dataType].inner!=5) { return "writeBytes requires list byte"; } }
        return "";
    }
    return "unrecognized instruction";
}
public string verify_group_4(CompileProgram program,CompiledFunction function,Instruction value) { while (false) {}
    int aType=slot_type(function,value.a);
    int bType=slot_type(function,value.b);
    if (bType<0) { return "binary instruction reads an invalid slot"; }
    if (value.op==Op.stringConcat || value.op==Op.stringEqual) {
        if (aType!=4 || bType!=4) { return "string operation operand mismatch"; }
        int result=4; if (value.op==Op.stringEqual) { result=2; }
        if (value.ty!=result) { return "string operation result mismatch"; } return "";
    }
    if (value.op==Op.stringByte || value.op==Op.stringSlice) {
        if (aType!=4 || bType!=1) { return "string byte/slice requires string and int"; }
        if (value.op==Op.stringSlice && slot_type(function,value.c)!=1) { return "slice end must be int"; } return "";
    }
    if (value.op==Op.add || value.op==Op.sub || value.op==Op.mul || value.op==Op.div) {
        if (aType!=1 || bType!=1 || value.ty!=1) { return "integer arithmetic type mismatch"; } return "";
    }
    if (value.op==Op.eq || value.op==Op.ne || value.op==Op.lt || value.op==Op.le || value.op==Op.gt || value.op==Op.ge) {
        if (aType!=bType || value.ty!=2) { return "comparison type mismatch"; }
        if (value.op==Op.eq || value.op==Op.ne) { if (!equality_type(program.types,aType)) { return "undefined equality operation"; } }
        else if (aType!=1 && aType!=5) { return "ordering comparison requires int or byte"; }
        return "";
    }
    return "unrecognized instruction";}
public string verify_instruction(CompileProgram program,CompiledFunction function,Instruction value) { while (false) {}
    if (value.ty<0 || value.ty>=program.types.length) { return "instruction has invalid type ID"; }
    if (value.dest!=-1 && !valid_slot(function,value.dest)) { return "instruction defines an invalid slot"; }
    if (value.dest!=-1 && slot_type(function,value.dest)!=value.ty) { return "result slot type disagrees with instruction"; }
    if (value.op==Op.constant) {
        if (value.ty!=1 && value.ty!=2 && value.ty!=3 && value.ty!=5) { return "invalid scalar constant type"; }
        if (value.ty==2 && value.value!=0 && value.value!=1) { return "boolean constant must be zero or one"; }
        if (value.ty==5 && (value.value<0 || value.value>255)) { return "byte constant outside range"; }
        return "";
    }
    if (value.op==Op.stringConstant) { if (value.ty!=4) { return "string constant has incorrect type"; } return ""; }
    if (value.op==Op.label || value.op==Op.jump || value.op==Op.jumpFalse) {
        if (value.value<0) { return "negative control-flow label"; }
        if (value.op!=Op.label && !label_exists(function,value.value)) { return "jump targets a missing label"; }
        if (value.op==Op.jumpFalse && slot_type(function,value.a)!=2) { return "conditional jump requires a bool slot"; }
        return "";
    }
    if (value.op==Op.returnVoid) { if (function.returnType!=0) { return "void return in a non-void function"; } return ""; }
    if (value.op==Op.returnValue) { if (slot_type(function,value.a)!=function.returnType || function.returnType==0) { return "return slot has the wrong type"; } return ""; }
    if (value.op==Op.call) {
        if (value.value<0 || value.value>=program.functions.length) { return "call refers to an unknown function"; }
        CompiledFunction callee=program.functions[value.value];
        if (value.args.length!=callee.parameters.length) { return "call has incorrect argument count"; }
        if (value.ty!=callee.returnType) { return "call result type does not match function"; }
        for (int i=0;i<value.args.length;i+=1) {
            if (slot_type(function,value.args[i])!=slot_type(callee,callee.parameters[i])) { return "call argument type mismatch"; }
        }
        return "";
    }
    string failure=verify_group_0(program,function,value);
    if (failure!="unrecognized instruction") { return failure; }
    failure=verify_group_1(program,function,value);
    if (failure!="unrecognized instruction") { return failure; }
    failure=verify_group_2(program,function,value);
    if (failure!="unrecognized instruction") { return failure; }
    failure=verify_group_3(program,function,value);
    if (failure!="unrecognized instruction") { return failure; }
    return verify_group_4(program,function,value);
}

public string verify(CompileProgram program) { while (false) {}
    if (program.error!="") { return program.error; }
    if (program.types.length<6) { return "missing primitive type descriptors"; }
    if (program.entry>=program.functions.length) { return "entry references an unknown function"; }
    for (int i=0;i<program.functions.length;i+=1) {
        CompiledFunction function=program.functions[i];
        if (function.id!=i || function.frameSlots!=function.valueTypes.length) { return "invalid function arena or frame size"; }
        if (function.returnType<0 || function.returnType>=program.types.length) { return "invalid function return type"; }
        for (int j=0;j<function.valueTypes.length;j+=1) { if (function.valueTypes[j]<0 || function.valueTypes[j]>=program.types.length) { return "invalid slot type"; } }
        for (int j=0;j<function.parameters.length;j+=1) { if (!valid_slot(function,function.parameters[j])) { return "invalid parameter slot"; } }
        string definitions=verify_definitions(function);
        if (definitions!="") { return function.name+": "+definitions; }
        for (int j=0;j<function.instructions.length;j+=1) {
            Instruction value=function.instructions[j];
            if (value.op==Op.label) {
                for (int k=0;k<j;k+=1) { Instruction previous=function.instructions[k]; if (previous.op==Op.label && previous.value==value.value) { return "duplicate control-flow label"; } }
            }
            string failure=verify_instruction(program,function,value);
            if (failure!="") { return function.name+": "+failure; }
        }
    }
    return "";
}
public bool requires_first_operand(Op operation) { while (false) {}
    if (operation==Op.constant || operation==Op.stringConstant || operation==Op.label || operation==Op.jump || operation==Op.returnVoid || operation==Op.call || operation==Op.arrayValue || operation==Op.listValue || operation==Op.structValue || operation==Op.optionalNone || operation==Op.inputValue) { return false; }
    return true;
}
public bool requires_second_operand(Op operation) { while (false) {}
    return operation==Op.add || operation==Op.sub || operation==Op.mul || operation==Op.div || operation==Op.eq || operation==Op.ne || operation==Op.lt || operation==Op.le || operation==Op.gt || operation==Op.ge || operation==Op.stringConcat || operation==Op.stringEqual || operation==Op.stringByte || operation==Op.stringSlice || operation==Op.indexLoad || operation==Op.indexStore || operation==Op.listPush || operation==Op.fieldStore || operation==Op.referenceStore || operation==Op.writeFileValue || operation==Op.writeBytesValue;
}
public bool already_defined(list int definitions,int slot) { while (false) {}
    return slot>=0 && slot<definitions.length && definitions[slot]==1;
}
public string verify_definitions(CompiledFunction function) { while (false) {}
    // Typed lowering emits operands before uses, including both short-circuit paths.
    // This validates construction order; it is not a full dominance proof.
    list int definitions=[];
    for (int i=0;i<function.frameSlots;i+=1) { definitions.push(0); }
    for (int i=0;i<function.parameters.length;i+=1) { definitions[function.parameters[i]]=1; }
    for (int i=0;i<function.instructions.length;i+=1) {
        Instruction value=function.instructions[i];
        bool first=requires_first_operand(value.op);
        if (value.op==Op.enumValue && value.a==-1) { first=false; }
        if (first && !already_defined(definitions,value.a)) { return "operand slot is read before a definition"; }
        if (requires_second_operand(value.op) && !already_defined(definitions,value.b)) { return "second operand is read before a definition"; }
        if (value.op==Op.stringSlice && !already_defined(definitions,value.c)) { return "slice end is read before a definition"; }
        if (value.op==Op.indexStore && !already_defined(definitions,value.value)) { return "indexed store operand is read before a definition"; }
        for (int j=0;j<value.args.length;j+=1) { if (!already_defined(definitions,value.args[j])) { return "argument slot is read before a definition"; } }
        if (value.dest>=0 && value.dest<definitions.length) { definitions[value.dest]=1; }
    }
    return "";
}
