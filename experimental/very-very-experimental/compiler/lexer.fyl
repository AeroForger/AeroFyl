// Adapted from the pre-existing compiler/frontend/lexer.fyl.
// Changes: in-memory source API, Unicode scalar decoding, and output interpolation.
use token;
use source;
use diagnostics;

private bool isWhitespace(int current) {
    while (false) { }
    return current == int(' ')
        || current == int('\n')
        || current == int('\r')
        || current == int('\t');
}

private bool isLetter(int current) {
    while (false) { }
    return (current >= int('a') && current <= int('z'))
        || (current >= int('A') && current <= int('Z'))
        || current == int('_');
}

private bool isDigit(int current) {
    while (false) { }
    return current >= int('0') && current <= int('9');
}

// Decode one scalar without relying on character indexing (strings are byte-oriented).
public int utf8_width(int leading) {
    while (false) { }
    if (leading < 128) { return 1; }
    if (leading >= 194 && leading <= 223) { return 2; }
    if (leading >= 224 && leading <= 239) { return 3; }
    if (leading >= 240 && leading <= 244) { return 4; }
    return 0;
}

public int utf8_scalar(string text, int offset) {
    while (false) { }
    // Existing bootstrap verifier workaround; see ../BOOTSTRAP_BLOCKER.md.
    if (offset < 0 || offset >= text.length) { return -1; }
    int leading = text.byte(offset);
    int width = utf8_width(leading);
    if (width == 0 || offset + width > text.length) { return -1; }
    if (width == 1) { return leading; }
    int value = leading - 192;
    int minimum = 128;
    if (width == 3) { value = leading - 224; minimum = 2048; }
    if (width == 4) { value = leading - 240; minimum = 65536; }
    int index = 1;
    while (index < width) {
        int part = text.byte(offset + index);
        if (part < 128 || part > 191) { return -1; }
        value = value * 64 + part - 128;
        index += 1;
    }
    if (value < minimum || value > 1114111 || (value >= 55296 && value <= 57343)) { return -1; }
    return value;
}

private Span span(Source source, int start, int end) {
    while (false) { }
    return Span {
        source: source.path,
        start: start,
        end: end
    };
}

private Token makeToken(TokenKind kind, Source source, int start, int end) {
    while (false) { }
    return Token {
        kind: kind,
        span: span(source, start, end)
    };
}
//Thinking of moving this to token.fyl
private TokenKind keywordOrIdentifier(string word) {
    while (false) { }
    if (word == "public") { return TokenKind.Keyword(Keyword.Public); }
    if (word == "private") { return TokenKind.Keyword(Keyword.Private); }
    if (word == "use") { return TokenKind.Keyword(Keyword.Use); }
    if (word == "using") { return TokenKind.Keyword(Keyword.Using); }
    if (word == "return") { return TokenKind.Keyword(Keyword.Return); }
    if (word == "if") { return TokenKind.Keyword(Keyword.If); }
    if (word == "else") { return TokenKind.Keyword(Keyword.Else); }
    if (word == "while") { return TokenKind.Keyword(Keyword.While); }
    if (word == "for") { return TokenKind.Keyword(Keyword.For); }
    if (word == "break") { return TokenKind.Keyword(Keyword.Break); }
    if (word == "continue") { return TokenKind.Keyword(Keyword.Continue); }
    if (word == "true") { return TokenKind.Keyword(Keyword.True); }
    if (word == "false") { return TokenKind.Keyword(Keyword.False); }
    if (word == "print") { return TokenKind.Keyword(Keyword.Print); }
    if (word == "input") { return TokenKind.Keyword(Keyword.Input); }
    if (word == "list") { return TokenKind.Keyword(Keyword.List); }
    if (word == "optional") { return TokenKind.Keyword(Keyword.Optional); }
    if (word == "ref") { return TokenKind.Keyword(Keyword.Ref); }
    if (word == "int") { return TokenKind.Keyword(Keyword.Int); }
    if (word == "byte") { return TokenKind.Keyword(Keyword.Byte); }
    if (word == "float") { return TokenKind.Keyword(Keyword.Float); }
    if (word == "bool") { return TokenKind.Keyword(Keyword.Bool); }
    if (word == "char") { return TokenKind.Keyword(Keyword.Char); }
    if (word == "string") { return TokenKind.Keyword(Keyword.String); }
    if (word == "void") { return TokenKind.Keyword(Keyword.Void); }
    if (word == "dynamic") { return TokenKind.Keyword(Keyword.Dynamic); }
    if (word == "struct") { return TokenKind.Keyword(Keyword.Struct); }
    if (word == "enum") { return TokenKind.Keyword(Keyword.Enum); }
    return TokenKind.Identifier(word);
}

//token spans use byte offsets matching Source.texts byte-oriented API
struct LexResult {
    list Token tokens;
    list Diagnostic diagnostics;
}

public LexResult lex_source(Source s) {
    while (false) { }
    string source = s.text;
    list Token tokens = [];
    list Diagnostic diagnostics = [];
    int offset = 0;

    while (offset < source.length) {
        int current = source.byte(offset);
        int start = offset;

        if (isWhitespace(current)) {
            offset = offset + 1;
            continue;
        }

        if (isLetter(current)) {
            while (
                offset < source.length
                && (isLetter(source.byte(offset)) || isDigit(source.byte(offset)))
            ) {
                offset = offset + 1;
            }
            string word = source.slice(start, offset);
            TokenKind kind = keywordOrIdentifier(word);
            tokens.push(makeToken(kind, s, start, offset));
            continue;
        }

        if (isDigit(current)) {
            while (offset < source.length && isDigit(source.byte(offset))) {
                offset = offset + 1;
            }
            if (offset + 1 < source.length
                && source.byte(offset) == int('.')
                && isDigit(source.byte(offset + 1))) {
                offset = offset + 1;
                while (offset < source.length && isDigit(source.byte(offset))) {
                    offset = offset + 1;
                }
                tokens.push(makeToken(TokenKind.Float(source.slice(start, offset)), s, start, offset));
            } else {
                tokens.push(makeToken(TokenKind.Integer(source.slice(start, offset)), s, start, offset));
            }
            continue;
        }
        //sigle line comment :D
        if (current == int('/') && offset + 1 < source.length && source.byte(offset + 1) == int('/')) {
            offset = offset + 2;
            while (offset < source.length && source.byte(offset) != int('\n') && source.byte(offset) != int('\r')) {
                offset = offset + 1;
            }
            continue;
        }

        //multi line comment :D
        if (current == int('/') && offset + 1 < source.length && source.byte(offset + 1) == int('*')) {
            offset = offset + 2;

            while (offset + 1 < source.length
                && !(source.byte(offset) == int('*') && source.byte(offset + 1) == int('/'))) {
                offset = offset + 1;
            }

            if (offset + 1 >= source.length) {
                diagnostics.push(error(ErrorType.LexicalError, "unterminated block comment", span(s, start, source.length)));
                offset = source.length;
                continue;
            }

            offset = offset + 2;
            continue;
        }

        if (current == int('\\') && offset + 2 < source.length
            && source.byte(offset + 1) == int('v') && source.byte(offset + 2) == int('"')) {
            offset += 3;
            int contentStart = offset;
            bool closed = false;
            while (offset < source.length && source.byte(offset) != int('\n') && source.byte(offset) != int('\r')) {
                if (source.byte(offset) == int('"')) { closed = true; break; }
                if (source.byte(offset) == int('\\') && offset + 1 < source.length) { offset += 1; }
                offset += 1;
            }
            if (closed) {
                string raw = source.slice(contentStart, offset);
                offset += 1;
                tokens.push(makeToken(TokenKind.Interpolated(raw), s, start, offset));
            } else {
                diagnostics.push(error(ErrorType.LexicalError, "unterminated interpolated output literal", span(s, start, offset)));
            }
            continue;
        }

        //escapes
        if (current == int('"')) {
            offset = offset + 1;
            string value = "";
            bool valid = true;
            bool closed = false;

            while (offset < source.length
                && source.byte(offset) != int('\n')
                && source.byte(offset) != int('\r')) {

                if (source.byte(offset) == int('"')) {
                    closed = true;
                    offset = offset + 1;
                    break;
                }

                if (source.byte(offset) == int('\\') && offset + 1 < source.length) {
                    offset = offset + 1;
                    int escape = source.byte(offset);

                    if (escape == int('n')) { value = value + "\n"; }
                    else if (escape == int('r')) { value = value + "\r"; }
                    else if (escape == int('t')) { value = value + "\t"; }
                    else if (escape == int('0')) { value = value + "\0"; }
                    else if (escape == int('\\')) { value = value + "\\"; }
                    else if (escape == int('"')) { value = value + "\""; }
                    else {
                        valid = false;
                    }

                    offset = offset + 1;
                } else {
                    value = value + source.slice(offset, offset + 1);
                    offset = offset + 1;
                }
            }

            if (!closed) {
                diagnostics.push(error(ErrorType.LexicalError, "unterminated string literal", span(s, start, offset)));
            } else if (!valid) {
                diagnostics.push(error(ErrorType.LexicalError, "unsupported string escape", span(s, start, offset)));
            } else {
                tokens.push(makeToken(TokenKind.String(value), s, start, offset));
            }

            continue;
        }

        if (current == int('\'')) {
            offset = offset + 1;
            if (offset >= source.length
                || source.byte(offset) == int('\n')
                || source.byte(offset) == int('\r')) {
                diagnostics.push(error(ErrorType.LexicalError, "unterminated character literal", span(s, start, offset)));
                continue;
            }

            int value = source.byte(offset);
            int width = 1;
            bool valid = true;
            if (value == int('\\')) {
                offset = offset + 1;
                if (offset >= source.length
                    || source.byte(offset) == int('\n')
                    || source.byte(offset) == int('\r')) {
                    diagnostics.push(error(ErrorType.LexicalError, "unterminated character escape", span(s, start, offset)));
                    continue;
                }
                value = source.byte(offset);
                if (value == int('n')) { value = int('\n'); }
                else if (value == int('r')) { value = int('\r'); }
                else if (value == int('t')) { value = int('\t'); }
                else if (value == int('0')) { value = 0; }
                else if (value != int('\\') && value != int('\'')) { valid = false; }
            } else {
                value = utf8_scalar(source, offset);
                width = utf8_width(source.byte(offset));
                if (value < 0) { valid = false; width = 1; }
            }
            offset = offset + width;
            if (valid && offset < source.length && source.byte(offset) == int('\'')) {
                offset = offset + 1;
                tokens.push(makeToken(TokenKind.Char(char(value)), s, start, offset));
                continue;
            }

            while (offset < source.length
                && source.byte(offset) != int('\'')
                && source.byte(offset) != int('\n')
                && source.byte(offset) != int('\r')) {
                offset = offset + 1;
            }
            if (offset < source.length && source.byte(offset) == int('\'')) {
                offset = offset + 1;
                diagnostics.push(error(ErrorType.LexicalError, "character literal must contain one character", span(s, start, offset)));
            } else {
                diagnostics.push(error(ErrorType.LexicalError, "unterminated character literal", span(s, start, offset)));
            }
            continue;
        }

        if (current == int('(')) { tokens.push(makeToken(TokenKind.LeftParen, s, start, start + 1)); }
        else if (current == int(')')) { tokens.push(makeToken(TokenKind.RightParen, s, start, start + 1)); }
        else if (current == int('{')) { tokens.push(makeToken(TokenKind.LeftBrace, s, start, start + 1)); }
        else if (current == int('}')) { tokens.push(makeToken(TokenKind.RightBrace, s, start, start + 1)); }
        else if (current == int('[')) { tokens.push(makeToken(TokenKind.LeftBracket, s, start, start + 1)); }
        else if (current == int(']')) { tokens.push(makeToken(TokenKind.RightBracket, s, start, start + 1)); }
        else if (current == int(',')) { tokens.push(makeToken(TokenKind.Comma, s, start, start + 1)); }
        else if (current == int(';')) { tokens.push(makeToken(TokenKind.Semicolon, s, start, start + 1)); }
        else if (current == int(':')) { tokens.push(makeToken(TokenKind.Colon, s, start, start + 1)); }
        else if (current == int('.')) { tokens.push(makeToken(TokenKind.Dot, s, start, start + 1)); }
        else if (current == int('=')) {
            if (offset + 1 < source.length && source.byte(offset + 1) == int('=')) { tokens.push(makeToken(TokenKind.EqualEqual, s, start, start + 2)); offset = offset + 1; }
            else { tokens.push(makeToken(TokenKind.Equal, s, start, start + 1)); }
        }
        else if (current == int('!')) {
            if (offset + 1 < source.length && source.byte(offset + 1) == int('=')) { tokens.push(makeToken(TokenKind.BangEqual, s, start, start + 2)); offset = offset + 1; }
            else { tokens.push(makeToken(TokenKind.Bang, s, start, start + 1)); }
        }
        else if (current == int('<')) {
            if (offset + 1 < source.length && source.byte(offset + 1) == int('=')) { tokens.push(makeToken(TokenKind.LessEqual, s, start, start + 2)); offset = offset + 1; }
            else { tokens.push(makeToken(TokenKind.Less, s, start, start + 1)); }
        }
        else if (current == int('>')) {
            if (offset + 1 < source.length && source.byte(offset + 1) == int('=')) { tokens.push(makeToken(TokenKind.GreaterEqual, s, start, start + 2)); offset = offset + 1; }
            else { tokens.push(makeToken(TokenKind.Greater, s, start, start + 1)); }
        }
        else if (current == int('&') && offset + 1 < source.length && source.byte(offset + 1) == int('&')) { tokens.push(makeToken(TokenKind.AmpersandAmpersand, s, start, start + 2)); offset = offset + 1; }
        else if (current == int('|') && offset + 1 < source.length && source.byte(offset + 1) == int('|')) { tokens.push(makeToken(TokenKind.PipePipe, s, start, start + 2)); offset = offset + 1; }
        else if (current == int('+')) {
            if (offset + 1 < source.length && source.byte(offset + 1) == int('=')) { tokens.push(makeToken(TokenKind.PlusEqual, s, start, start + 2)); offset = offset + 1; }
            else { tokens.push(makeToken(TokenKind.Plus, s, start, start + 1)); }
        }
        else if (current == int('-')) {
            if (offset + 1 < source.length && source.byte(offset + 1) == int('=')) { tokens.push(makeToken(TokenKind.MinusEqual, s, start, start + 2)); offset = offset + 1; }
            else { tokens.push(makeToken(TokenKind.Minus, s, start, start + 1)); }
        }
        else if (current == int('*')) {
            if (offset + 1 < source.length && source.byte(offset + 1) == int('=')) { tokens.push(makeToken(TokenKind.StarEqual, s, start, start + 2)); offset = offset + 1; }
            else { tokens.push(makeToken(TokenKind.Star, s, start, start + 1)); }
        }
        else if (current == int('/')) {
            if (offset + 1 < source.length && source.byte(offset + 1) == int('=')) { tokens.push(makeToken(TokenKind.SlashEqual, s, start, start + 2)); offset = offset + 1; }
            else { tokens.push(makeToken(TokenKind.Slash, s, start, start + 1)); }
        }
        else{
            diagnostics.push(error(ErrorType.LexicalError, "unexpected or unsupported identifier character", span(s, start, offset + 1)));
        }
        offset = offset + 1;
    }
    tokens.push(makeToken(TokenKind.Eof, s, offset, offset));
    return LexResult { tokens: tokens, diagnostics: diagnostics };
}

public LexResult lex(string path) {
    while (false) { }
    return lex_source(load_file(path));
}
