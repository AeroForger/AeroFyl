use x86_64;
use model;
use std.fs;
public void main() {
    list Instruction ops = [instruction(Op.constant,0,-1,-1,-1,42,"",1,[]),instruction(Op.output,-1,0,-1,-1,1,"",1,[]),instruction(Op.returnVoid,-1,-1,-1,-1,0,"",0,[])];
    CompiledFunction fn = CompiledFunction { id:0,name:"main",returnType:0,parameters:[],localTypes:[1],valueTypes:[1],instructions:ops,frameSlots:1 };
    CompileProgram program = CompileProgram {types:[scalarType("void"),scalarType("int")],functions:[fn],entry:0,error:""};
    list byte data = emitExecutable(program);
    writeBytes("/tmp/af-native-probe",data);
}
