// The empty entry loop avoids the unchanged bootstrap verifier fixed-point bug.
use ast;

// Whole imports expose their transitive graph; selective edges expose one name.
// idc
public bool import_visible(AstProgram program, string source, string target, string name) { while (false) {}
    if (source == target) { return true; }
    list string pending = [source];
    list string seen = [];
    while (pending.length > 0) {
        string file = pending.pop();
        bool visited = false;
        for (int i = 0; i < seen.length; i += 1) {
            if (seen[i] == file) { visited = true; }
        }
        if (!visited) {
            seen.push(file);
            for (int i = 0; i < program.imports.length; i += 1) {
                AstImport dependency = program.imports[i];
                if (dependency.span.source == file && dependency.target != "") {
                    if (dependency.selective) {
                        if (dependency.target == target) {
                            for (int j = 0; j < dependency.selected.length; j += 1) {
                                if (dependency.selected[j] == name) { return true; }
                            }
                        }
                    } else {
                        if (dependency.target == target) { return true; }
                        pending.push(dependency.target);
                    }
                }
            }
        }
    }
    return false;
}

public bool has_standard_import(AstProgram program, string name) { while (false) {}
    // This follows the bootstrap's program-wide builtin table.
    for (int i = 0; i < program.imports.length; i += 1) {
        if (program.imports[i].name == name) { return true; }
    }
    return false;
}
