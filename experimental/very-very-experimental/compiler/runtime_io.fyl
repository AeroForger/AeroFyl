public void nativeRuntimeIO(ref NativeImage image) {
    while (false) {}
    ioPathHelper(image); ioReadHelper(image); ioWriteHelper(image);
    ioInputLine(image); ioInputInteger(image); ioInputBoolean(image); ioInputCharacter(image); ioInputError(image);
    nativeLabel(image, 30001); ioWriteText(image, 39900, 14); nativeJump(image, 1);
    nativeLabel(image, 30002); ioWriteText(image, 39901, 15); nativeJump(image, 1);
    nativeLabel(image, 30003); ioWriteText(image, 39902, 16); nativeJump(image, 1);
    ioText(image, 39900, "FileReadError\n"); ioText(image, 39901, "FileWriteError\n"); ioText(image, 39902, "FileSystemError\n");
    ioText(image, 39903, "InputTypeError: expected "); ioText(image, 39904, "int"); ioText(image, 39905, "bool"); ioText(image, 39906, "char");
    ioText(image, 39907, ", got \""); ioText(image, 39908, "\"\n");
}
