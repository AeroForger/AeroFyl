use emitter;

private void ioCompare(ref NativeImage image, int reg, int value) {
    while (false) {}
    nativeImm(image, 1, value); nativeBinary(image, 57, reg, 1);
}
private void ioAdd(ref NativeImage image, int reg, int value) {
    while (false) {}
    nativeImm(image, 1, value); nativeBinary(image, 1, reg, 1);
}
private void ioText(ref NativeImage image, int label, string text) {
    while (false) {}
    nativeLabel(image, label);
    for (int i = 0; i < text.length; i += 1) { nativeByte(image, text.byte(i)); }
}
private void ioWriteText(ref NativeImage image, int label, int length) {
    while (false) {}
    nativeAddress(image, label); nativeMove(image, 6, 0);
    nativeImm(image, 7, 2); nativeImm(image, 2, length); nativeCall(image, 4);
}

private void ioPathHelper(ref NativeImage image) {
