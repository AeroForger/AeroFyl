    nativeCall(image, 2); nativeStore(image, 5, -24, 0);
    nativeMove(image, 7, 0); nativeLoad(image, 6, 5, -8); ioAdd(image, 6, 8);
    nativeLoad(image, 2, 5, -16); nativeCall(image, 30004);
    nativeLoad(image, 0, 5, -24); nativeLoad(image, 2, 5, -16);
    nativeBinary(image, 1, 2, 0); nativeImm(image, 1, 0); nativeStoreByte(image, 2, 0, 1);
    nativeReturn(image);
    // RDI destination, RSI source, RDX count -> destination in RAX.
    nativeLabel(image, 30004); nativeMove(image, 0, 7);
    nativeLabel(image, 30005); ioCompare(image, 2, 0); nativeBranch(image, 4, 30006);
    nativeLoadByte(image, 8, 6, 0); nativeStoreByte(image, 7, 0, 8);
    ioAdd(image, 7, 1); ioAdd(image, 6, 1); ioAdd(image, 2, -1); nativeJump(image, 30005);
    nativeLabel(image, 30006); nativeByte(image, 195);
}

