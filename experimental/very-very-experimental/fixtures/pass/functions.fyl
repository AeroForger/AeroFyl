use std.io;
private int factorial(int n) {
    if (n <= 1) { return 1; }
    return n * factorial(n - 1);
}
private int sum(int a, int b, int c, int d, int e, int f, int g, int h, int i) {
    return a + b + c + d + e + f + g + h + i;
}
private void log(int value) { println(value); }
public void main() {
    log(factorial(8));
    println(sum(1, 2, 3, 4, 5, 6, 7, 8, 9));
}
