use std.fs;

public void main(string[] args)
{
    std.fs.writeFile(args[0], "first");
    if (!std.fs.exists(args[0]) || std.fs.exists(args[1]) || !std.fs.exists(args[2]))
    {
        exit(61);
    }

    std.fs.writeFile(args[0], "replacement");
    string text = std.fs.readFile(args[0]);
    if (text != "replacement")
    {
        exit(62);
    }

    std.fs.writeFile(args[0], "");
    string empty = std.fs.readFile(args[0]);
    if (empty.length != 0)
    {
        exit(63);
    }
}
