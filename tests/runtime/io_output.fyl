use std.io;

public void main()
{
    std.io.print("");
    std.io.print("Hello");
    std.io.println(", World!");
    std.io.println(123);
    std.io.println(-456);
    std.io.println(0);
    std.io.println(-9223372036854775808);
    std.io.println(true);
    std.io.println(false);
    std.io.print('A');
    std.io.println('é');

    std.io.eprint("error: ");
    std.io.eprintln("something happened");
}
