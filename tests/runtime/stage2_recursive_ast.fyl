struct Span {
    int start;
    int end;
}

struct LiteralNode {
    int value;
}

struct BinaryNode {
    ref Expression left;
    ref Expression right;
}

struct CallNode {
    string name;
    list ref Expression arguments;
}

enum ExpressionKind {
    literal(LiteralNode),
    identifier(string),
    binary(BinaryNode),
    call(CallNode)
}

struct Expression {
    ExpressionKind kind;
    Span span;
}

struct Diagnostic {
    string message;
    Span span;
}

enum ParseResult {
    ok(ref Expression),
    error(Diagnostic)
}

private ref Expression integer(int value) {
    return reference(Expression {
        kind: ExpressionKind.literal(LiteralNode { value: value }),
        span: Span { start: 0, end: 1 }
    });
}

private ref Expression add(ref Expression left, ref Expression right) {
    return reference(Expression {
        kind: ExpressionKind.binary(BinaryNode { left: left, right: right }),
        span: Span { start: left.value.span.start, end: right.value.span.end }
    });
}

private int evaluate(ref Expression expression) {
    if (expression.value.kind.is(ExpressionKind.literal)) {
        LiteralNode literal = expression.value.kind.payload(ExpressionKind.literal);
        return literal.value;
    } else if (expression.value.kind.is(ExpressionKind.binary)) {
        BinaryNode binary = expression.value.kind.payload(ExpressionKind.binary);
        return evaluate(binary.left) + evaluate(binary.right);
    } else if (expression.value.kind.is(ExpressionKind.call)) {
        CallNode call = expression.value.kind.payload(ExpressionKind.call);
        int total = 0;
        int i = 0;
        while (i < call.arguments.length) {
            total += evaluate(call.arguments[i]);
            i += 1;
        }
        return total;
    }
    return 0;
}

private ParseResult parse(bool valid) {
    if (valid) {
        return ParseResult.ok(add(integer(20), integer(22)));
    }
    return ParseResult.error(Diagnostic {
        message: "expected expression",
        span: Span { start: 4, end: 4 }
    });
}

private int[2] positions() {
    return [3, 4];
}

private int sumPositions(int[2] values) {
    return values[0] + values[1];
}

public void main() {
    ParseResult success = parse(true);
    if (!success.is(ParseResult.ok)) {
        exit(1);
    }
    ref Expression tree = success.payload(ParseResult.ok);
    if (evaluate(tree) != 42) {
        exit(2);
    }

    ref Expression alias = tree;
    alias.value = Expression {
        kind: ExpressionKind.literal(LiteralNode { value: 7 }),
        span: Span { start: 0, end: 1 }
    };
    if (evaluate(tree) != 7) {
        exit(3);
    }
    Expression copied = tree.value;
    copied.span = Span { start: 9, end: 10 };
    if (tree.value.span.start != 0 || copied.span.start != 9) {
        exit(7);
    }
    ref Expression call = reference(Expression {
        kind: ExpressionKind.call(CallNode {
            name: "sum",
            arguments: [integer(2), integer(3)]
        }),
        span: Span { start: 0, end: 3 }
    });
    if (evaluate(call) != 5) {
        exit(8);
    }
    int[2] offsets = positions();
    if (sumPositions(offsets) != 7) {
        exit(6);
    }

    ParseResult failure = parse(false);
    if (!failure.is(ParseResult.error)) {
        exit(4);
    }
    Diagnostic diagnostic = failure.payload(ParseResult.error);
    if (diagnostic.span.start != 4 || diagnostic.message.length != 19) {
        exit(5);
    }
}
