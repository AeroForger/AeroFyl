struct Bucket
{
    list int values;
    int[2] fixed;
    optional string label;
}

private Bucket makeBucket(int base)
{
    return Bucket {
        values: [base, base + 1],
        fixed: [base + 2, base + 3],
        label: some("line\n\t\r\0\\\"")
    };
}

private int inspect(Bucket bucket)
{
    bucket.values[0] += 4;
    bucket.fixed[1] *= 2;
    if (bucket.label.hasValue && bucket.label.value.length == 10) {
        return bucket.values[0] + bucket.fixed[1];
    }
    return 0;
}

private optional int findValue(bool exists)
{
    if (exists) {
        return some(7);
    }
    return none();
}

public void main()
{
    // Nested list literals retain their exact element types.
    list list int matrix = [[1, 2], [3, 4]];
    matrix[1][0] += 5;
    matrix[1].push(5);
    matrix[1].push(6);
    matrix[1].push(7);
    int last = matrix[1].pop();

    /* Collections stored in structs are usable after a struct return and
       after a value-parameter copy. */
    Bucket bucket = makeBucket(3);
    bucket.values = [3, 4];
    bucket.fixed = [5, 6];
    bucket.label = some("line\n\t\r\0\\\"");
    Bucket copy = bucket;
    copy.values[0] = 9;
    int result = inspect(bucket);

    optional int absent = none();
    optional int found = findValue(true);
    int branch = 0;
    int arithmetic = 20;
    arithmetic -= 5;
    arithmetic /= 3;
    if (absent.hasValue) {
        branch = 1;
    } else if (matrix[1][0] == 8) {
        branch += 2;
    } else {
        branch = 3;
    }

    if (result != 25 || branch != 2 || arithmetic != 5 || last != 7 || matrix[1].length != 4 || !found.hasValue || found.value != 7) {
        exit(1);
    }
}
