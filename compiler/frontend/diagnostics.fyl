// Diagnostic carriers shared by the lexer and parser. Diagnostics travelled
// in one list historically; errors and warnings are now partitioned by level
// so warnings never fail compilation.
use source;
use ErrorType;
use WarningType;


enum DiagnosticLevel {
    Error(ErrorType),
    Warning(WarningType),
    Note,
}

struct Diagnostic {
    DiagnosticLevel level;
    string message;
    Span span;
}

public Diagnostic error(ErrorType error, string message, Span span) {
    return Diagnostic {
        level: DiagnosticLevel.Error(error),
        message: message,
        span: span
    };
}
public Diagnostic warning(WarningType warning, string message, Span span){
    return Diagnostic {
        level: DiagnosticLevel.Warning(warning),
        message: message,
        span: span
    };
}
public Diagnostic note(string message, Span span) {
    return Diagnostic {
        level: DiagnosticLevel.Note,
        message: message,
        span: span
    };
}

public bool isErrorDiagnostic(Diagnostic diagnostic) {
    return diagnostic.level.is(DiagnosticLevel.Error);
}

public bool isWarningDiagnostic(Diagnostic diagnostic) {
    return diagnostic.level.is(DiagnosticLevel.Warning);
}