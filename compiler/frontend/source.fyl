// File loading and byte-oriented source spans for the frontend.
use std.fs;


//File reading:
struct Source {
    string path;
    string text;
}
public Source load_file(string path){
    return Source {
        path: path,
        text: readFile(path)
    };
}
/*--------*/

//span
struct Span {
    string source;
    int start;
    int end;
}
/*--------*/
