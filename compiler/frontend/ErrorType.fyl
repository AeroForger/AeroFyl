enum ErrorType {
    SyntaxError,
    LexicalError,
    TypeError,
    ReferenceError,
    CompilationError,
    SemanticError,

    RuntimeError,
    NullPointerError,
    IndexOutOfBoundsError,
    DivisionByZeroError,
    StackOverflowError,
    OutOfMemoryError,

    FileReadError,
    FileWriteError,
}